{
  "name": "wealthfolio-addons-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:assets-perf": "pnpm --filter wealthfolio-assets-performance-addon dev",
    "dev:dividends": "pnpm --filter wealthfolio-dividend-projection-addon dev",
    "dev:metrics": "pnpm --filter wealthfolio-portfolio-metrics-addon dev",
    "dev:performance": "pnpm --filter wealthfolio-monthly-performance-addon dev",
    "build": "pnpm -r run build",
    "build:assets-perf": "pnpm --filter wealthfolio-assets-performance-addon build",
    "build:dividends": "pnpm --filter wealthfolio-dividend-projection-addon build",
    "build:metrics": "pnpm --filter wealthfolio-portfolio-metrics-addon build",
    "build:performance": "pnpm --filter wealthfolio-monthly-performance-addon build",
    "test": "pnpm -r run test",
    "test:assets-perf": "pnpm --filter wealthfolio-assets-performance-addon test",
    "test:dividends": "pnpm --filter wealthfolio-dividend-projection-addon test",
    "test:metrics": "pnpm --filter wealthfolio-portfolio-metrics-addon test",
    "test:performance": "pnpm --filter wealthfolio-monthly-performance-addon test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r run type-check",
    "package": "pnpm -r run package && mkdir -p dist && cp packages/*/dist/*.zip dist/",
    "package:assets-perf": "pnpm --filter wealthfolio-assets-performance-addon package && mkdir -p dist && cp packages/assets-performance-addon/dist/*.zip dist/",
    "package:dividends": "pnpm --filter wealthfolio-dividend-projection-addon package && mkdir -p dist && cp packages/dividends-projection-addon/dist/*.zip dist/",
    "package:metrics": "pnpm --filter wealthfolio-portfolio-metrics-addon package && mkdir -p dist && cp packages/portfolio-metrics-addon/dist/*.zip dist/",
    "package:performance": "pnpm --filter wealthfolio-monthly-performance-addon package && mkdir -p dist && cp packages/monthly-performance-addon/dist/*.zip dist/",
    "pre-commit": "prek run --all-files",
    "clean": "pnpm -r run clean && rm -rf dist"
  },
  "keywords": [
    "wealthfolio",
    "addons",
    "monorepo",
    "dividends",
    "metrics",
    "performance",
    "monthly",
    "alpha",
    "portfolio"
  ],
  "author": "thibaultserti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thibaultserti/wealthfolio-addons.git"
  },
  "homepage": "https://github.com/thibaultserti/wealthfolio-addons#readme",
  "bugs": {
    "url": "https://github.com/thibaultserti/wealthfolio-addons/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
