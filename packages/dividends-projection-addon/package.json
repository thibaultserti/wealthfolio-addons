{
  "name": "wealthfolio-dividend-projection-addon",
  "version": "1.0.0",
  "description": "Visualize and project future dividend income, dividend yield, yield on cost, and historical dividend growth across portfolios",
  "type": "module",
  "main": "dist/addon.js",
  "keywords": [
    "wealthfolio",
    "addon",
    "dividends",
    "projection",
    "yield",
    "income"
  ],
  "license": "MIT",
  "author": "thibaultserti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thibaultserti/wealthfolio-addons.git",
    "directory": "packages/dividends-projection-addon"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "package": "pnpm build && zip -r dist/dividends-projection-addon.zip manifest.json dist/addon.js README.md",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.6.2",
